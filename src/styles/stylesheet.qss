/* ========================================
   Modern Cyber/Tech Theme - VDD Audit System
   Deep blue-black background with indigo/violet accents
   ======================================== */

/* Base Widget Styling */
QWidget {
    background-color: #0A0E1A;
    color: #F8FAFC;
    font-family: "Segoe UI", "Inter", "Roboto", "Arial", sans-serif;
    font-size: 13px;
}

/* ========================================
   GroupBox - Glass Morphism Effect
   ======================================== */
QGroupBox {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 rgba(21, 27, 46, 0.8), stop:1 rgba(21, 27, 46, 0.95));
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 12px;
    margin-top: 20px;
    padding: 16px;
    font-weight: 600;
    color: #E2E8F0;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    left: 12px;
    padding: 0 8px;
    background: transparent;
    color: #6366F1;
    font-size: 14px;
    font-weight: 700;
}

/* ========================================
   QLineEdit - Enhanced Input Fields
   ======================================== */
QLineEdit {
    background: rgba(15, 23, 42, 0.8);
    border: 2px solid rgba(99, 102, 241, 0.3);
    border-radius: 8px;
    color: #F8FAFC;
    padding: 10px 12px;
    font-size: 13px;
    selection-background-color: #6366F1;
    selection-color: #FFFFFF;
}

QLineEdit:focus {
    border: 2px solid rgba(99, 102, 241, 0.8);
    background: rgba(15, 23, 42, 1);
}

QLineEdit:hover {
    border: 2px solid rgba(99, 102, 241, 0.5);
}

QLineEdit:disabled {
    background: rgba(30, 41, 59, 0.5);
    border: 2px solid rgba(99, 102, 241, 0.1);
    color: #64748B;
}

/* ========================================
   QComboBox - Modern Dropdown
   ======================================== */
QComboBox {
    background: rgba(15, 23, 42, 0.8);
    border: 2px solid rgba(99, 102, 241, 0.3);
    border-radius: 8px;
    color: #F8FAFC;
    padding: 8px 12px;
    min-height: 28px;
}

QComboBox:hover {
    border: 2px solid rgba(99, 102, 241, 0.5);
}

QComboBox:focus {
    border: 2px solid rgba(99, 102, 241, 0.8);
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 24px;
    border-left: 1px solid rgba(99, 102, 241, 0.3);
}

QComboBox QAbstractItemView {
    background: rgba(15, 23, 42, 0.95);
    border: 2px solid rgba(99, 102, 241, 0.3);
    selection-background-color: rgba(99, 102, 241, 0.3);
    selection-color: #F8FAFC;
    color: #F8FAFC;
    border-radius: 8px;
    outline: none;
}

QComboBox QAbstractItemView::item {
    padding: 8px 12px;
    min-height: 28px;
}

QComboBox QAbstractItemView::item:hover {
    background: rgba(99, 102, 241, 0.2);
}

/* ========================================
   QPushButton - Advanced Gradient Buttons
   ======================================== */
QPushButton {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(99, 102, 241, 0.8), stop:1 rgba(99, 102, 241, 1));
    border: none;
    border-radius: 8px;
    color: #FFFFFF;
    padding: 10px 20px;
    font-weight: 600;
    font-size: 13px;
}

QPushButton:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(99, 102, 241, 1), stop:1 rgba(139, 92, 246, 1));
}

QPushButton:pressed {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(99, 102, 241, 0.6), stop:1 rgba(99, 102, 241, 0.8));
}

QPushButton:disabled {
    background: rgba(30, 41, 59, 0.5);
    color: #64748B;
    border: none;
}

/* Special Button Variants */
QPushButton[success="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(34, 197, 94, 0.8), stop:1 rgba(34, 197, 94, 1));
}

QPushButton[success="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(34, 197, 94, 1), stop:1 rgba(16, 185, 129, 1));
}

QPushButton[danger="true"] {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(239, 68, 68, 0.8), stop:1 rgba(239, 68, 68, 1));
}

QPushButton[danger="true"]:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(239, 68, 68, 1), stop:1 rgba(220, 38, 38, 1));
}

/* ========================================
   QSlider - Modern Slider
   ======================================== */
QSlider::groove:horizontal {
    border: none;
    height: 8px;
    background: rgba(15, 23, 42, 0.8);
    border-radius: 4px;
}

QSlider::handle:horizontal {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #6366F1, stop:1 #8B5CF6);
    border: 2px solid rgba(99, 102, 241, 0.5);
    width: 18px;
    height: 18px;
    margin: -5px 0;
    border-radius: 9px;
}

QSlider::handle:horizontal:hover {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #818CF8, stop:1 #A78BFA);
    border: 2px solid rgba(99, 102, 241, 0.8);
}

/* ========================================
   QTableWidget - Advanced Table Styling
   ======================================== */
QTableWidget {
    background: rgba(10, 14, 26, 0.95);
    alternate-background-color: #111625; /* Premium dark alternate color */
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 12px;
    gridline-color: rgba(99, 102, 241, 0.1);
    color: #F8FAFC;
    outline: none;
}

QTableWidget::item {
    padding: 10px 8px;
    border-bottom: 1px solid rgba(99, 102, 241, 0.1);
    background-color: transparent;
}

QTableWidget::item:alternate {
    background-color: rgba(21, 27, 46, 0.5);
}

QTableWidget::item:hover {
    background: rgba(99, 102, 241, 0.1);
    color: #FFFFFF;
}

QTableWidget::item:selected {
    background: rgba(99, 102, 241, 0.2);
    color: #FFFFFF;
    font-weight: 600;
}

QHeaderView::section {
    background: rgba(21, 27, 46, 0.8);
    color: #94A3B8;
    padding: 10px 8px;
    font-weight: 700;
    font-size: 12px;
    border: none;
    border-bottom: 2px solid rgba(99, 102, 241, 0.3);
    border-right: 1px solid rgba(99, 102, 241, 0.1);
}

QHeaderView::section:first {
    border-top-left-radius: 12px;
}

QHeaderView::section:last {
    border-top-right-radius: 12px;
    border-right: none;
}

QTableWidget QTableCornerButton::section {
    background: rgba(21, 27, 46, 0.8);
    border: none;
    border-top-left-radius: 12px;
}

/* ========================================
   QScrollBar - Custom Scrollbars
   ======================================== */
QScrollBar:vertical {
    border: none;
    background: rgba(10, 14, 26, 0.5);
    width: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:vertical {
    background: rgba(99, 102, 241, 0.3);
    min-height: 30px;
    border-radius: 5px;
}

QScrollBar::handle:vertical:hover {
    background: rgba(99, 102, 241, 0.5);
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    border: none;
    background: rgba(10, 14, 26, 0.5);
    height: 10px;
    margin: 0px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal {
    background: rgba(99, 102, 241, 0.3);
    min-width: 30px;
    border-radius: 5px;
}

QScrollBar::handle:horizontal:hover {
    background: rgba(99, 102, 241, 0.5);
}

/* ========================================
   QProgressBar - Animated Progress Bars
   ======================================== */
QProgressBar {
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 10px;
    text-align: center;
    color: #FFFFFF;
    font-weight: 700;
    font-size: 12px;
    height: 24px;
}

QProgressBar::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #6366F1, stop:0.5 #8B5CF6, stop:1 #6366F1);
    border-radius: 8px;
}

QProgressBar[processing="true"]::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #F59E0B, stop:1 #FB923C);
}

QProgressBar[complete="true"]::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #22C55E, stop:1 #16A34A);
}

QProgressBar[error="true"]::chunk {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #EF4444, stop:1 #DC2626);
}

/* ========================================
   QLabel - Status Badges
   ======================================== */
QLabel {
    color: #94A3B8;
}

QLabel[status="success"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(34, 197, 94, 0.2), stop:1 rgba(34, 197, 94, 0.3));
    color: #22C55E;
    border: 1px solid rgba(34, 197, 94, 0.5);
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 600;
    font-size: 12px;
}

QLabel[status="error"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(239, 68, 68, 0.2), stop:1 rgba(239, 68, 68, 0.3));
    color: #EF4444;
    border: 1px solid rgba(239, 68, 68, 0.5);
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 600;
    font-size: 12px;
}

QLabel[status="warning"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(245, 158, 11, 0.2), stop:1 rgba(245, 158, 11, 0.3));
    color: #F59E0B;
    border: 1px solid rgba(245, 158, 11, 0.5);
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 600;
    font-size: 12px;
}

QLabel[status="info"] {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(99, 102, 241, 0.2), stop:1 rgba(99, 102, 241, 0.3));
    color: #6366F1;
    border: 1px solid rgba(99, 102, 241, 0.5);
    border-radius: 6px;
    padding: 6px 14px;
    font-weight: 600;
    font-size: 12px;
}

/* ========================================
   QCheckBox - Modern Checkboxes
   ======================================== */
QCheckBox {
    color: #94A3B8;
    spacing: 8px;
}

QCheckBox::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(99, 102, 241, 0.3);
    border-radius: 4px;
    background: rgba(15, 23, 42, 0.8);
}

QCheckBox::indicator:hover {
    border: 2px solid rgba(99, 102, 241, 0.5);
}

QCheckBox::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #6366F1, stop:1 #8B5CF6);
    border: 2px solid #6366F1;
}

/* ========================================
   QRadioButton - Modern Radio Buttons
   ======================================== */
QRadioButton {
    color: #94A3B8;
    spacing: 8px;
}

QRadioButton::indicator {
    width: 20px;
    height: 20px;
    border: 2px solid rgba(99, 102, 241, 0.3);
    border-radius: 10px;
    background: rgba(15, 23, 42, 0.8);
}

QRadioButton::indicator:hover {
    border: 2px solid rgba(99, 102, 241, 0.5);
}

QRadioButton::indicator:checked {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 #6366F1, stop:1 #8B5CF6);
    border: 2px solid #6366F1;
}

/* ========================================
   QFileDialog - Modern File Dialog
   ======================================== */
QFileDialog {
    background-color: #0A0E1A;
}

QFileDialog QListView {
    background-color: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 8px;
    show-decoration-selected: 1;
}

QFileDialog QListView::item {
    color: #F8FAFC;
    padding: 5px;
}

QFileDialog QListView::item:hover {
    background: rgba(99, 102, 241, 0.1);
}

QFileDialog QListView::item:selected {
    background: rgba(99, 102, 241, 0.2);
    color: #FFFFFF;
}

/* ========================================
   QMessageBox - Modern Message Box
   ======================================== */
QMessageBox {
    background: rgba(10, 14, 26, 0.95);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 12px;
}

QMessageBox QLabel {
    color: #F8FAFC;
    font-size: 13px;
}

QMessageBox QPushButton {
    min-width: 80px;
    padding: 8px 16px;
}

/* ========================================
   QToolTip - Enhanced Tooltips
   ======================================== */
QToolTip {
    background: rgba(15, 23, 42, 0.95);
    color: #F8FAFC;
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 12px;
}

/* ========================================
   QMainWindow - Main Window Styling
   ======================================== */
QMainWindow {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #0A0E1A, stop:1 #0F1419);
}

QMenuBar {
    background: rgba(15, 23, 42, 0.8);
    border: none;
    color: #94A3B8;
}

QMenuBar::item {
    background: transparent;
    padding: 8px 12px;
}

QMenuBar::item:selected {
    background: rgba(99, 102, 241, 0.2);
    color: #FFFFFF;
}

QMenu {
    background: rgba(15, 23, 42, 0.95);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 8px;
    color: #F8FAFC;
}

QMenu::item {
    padding: 8px 16px;
}

QMenu::item:selected {
    background: rgba(99, 102, 241, 0.2);
}

QToolBar {
    background: rgba(15, 23, 42, 0.8);
    border: none;
    spacing: 4px;
    padding: 4px;
}

QToolBar::handle {
    background: rgba(99, 102, 241, 0.3);
    width: 2px;
    margin: 4px;
}

/* ========================================
   Custom App-Specific Widget Selectors
   ======================================== */

/* Primary action - Blue */
QPushButton#importVddBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #2563EB, stop:1 #1D4ED8);
    border: 1px solid rgba(37, 99, 235, 0.5);
}
QPushButton#importVddBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #3B82F6, stop:1 #2563EB);
    border: 1px solid rgba(59, 130, 246, 0.8);
}
QPushButton#importVddBtn:pressed {
    background: #1E40AF;
}

/* Verification action - Indigo */
QPushButton#verifyLocalBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #4F46E5, stop:1 #4338CA);
    border: 1px solid rgba(79, 70, 229, 0.5);
}
QPushButton#verifyLocalBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #6366F1, stop:1 #4F46E5);
    border: 1px solid rgba(99, 102, 241, 0.8);
}
QPushButton#verifyLocalBtn:pressed {
    background: #3730A3;
}

/* Success action - Green */
QPushButton#exportResultsBtn, QPushButton#settingsSaveBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #059669, stop:1 #047857);
    border: 1px solid rgba(5, 150, 105, 0.5);
}
QPushButton#exportResultsBtn:hover, QPushButton#settingsSaveBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #10B981, stop:1 #059669);
    border: 1px solid rgba(16, 185, 129, 0.8);
}
QPushButton#exportResultsBtn:pressed, QPushButton#settingsSaveBtn:pressed {
    background: #065F46;
}

/* Neutral/Cancel action - Dark Grey */
QPushButton#settingsCancelBtn, QPushButton#clearReviewBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #374151, stop:1 #1F2937);
    border: 1px solid rgba(75, 85, 99, 0.5);
}
QPushButton#settingsCancelBtn:hover, QPushButton#clearReviewBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #4B5563, stop:1 #374151);
    border: 1px solid rgba(107, 114, 128, 0.8);
}
QPushButton#settingsCancelBtn:pressed, QPushButton#clearReviewBtn:pressed {
    background: #111827;
}

/* Neutral Discovery button - Smaller padding */
QPushButton#settingsDiscoverBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #4B5563, stop:1 #374151);
    padding: 6px 12px;
    font-size: 11px;
}
QPushButton#settingsDiscoverBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #6B7280, stop:1 #4B5563);
}

/* Document Review Run button */
QPushButton#runReviewBtn {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #6366F1, stop:1 #4F46E5);
    padding: 6px 16px;
    font-weight: bold;
}
QPushButton#runReviewBtn:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 #818CF8, stop:1 #6366F1);
}

/* Action Log Panel styling */
QTextEdit#actionLogText {
    background: #070A13;
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 8px;
    font-family: 'Consolas', 'Monaco', monospace;
    font-size: 11px;
    padding: 6px;
    color: #F8FAFC;
}

/* Document Reviewer Panel styling */
QTextEdit#llmReviewPanel {
    background: rgba(15, 23, 42, 0.9);
    color: #E2E8F0;
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 8px;
    padding: 8px;
}

/* ========================================
   QTabWidget & QTabBar - Premium Dark Tabs
   ======================================== */
QTabWidget::pane {
    border: 1px solid rgba(99, 102, 241, 0.3);
    background: #0A0E1A;
    border-radius: 12px;
    top: -1px;
}

QTabBar::tab {
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-bottom: none;
    color: #94A3B8;
    padding: 10px 20px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    margin-right: 4px;
    font-weight: 600;
}

QTabBar::tab:hover {
    background: rgba(99, 102, 241, 0.1);
    color: #F8FAFC;
    border-color: rgba(99, 102, 241, 0.4);
}

QTabBar::tab:selected {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(99, 102, 241, 0.2), stop:1 rgba(15, 23, 42, 1));
    border: 1px solid rgba(99, 102, 241, 0.6);
    border-bottom: 2px solid #6366F1;
    color: #FFFFFF;
}

QTabBar::tab:selected:hover {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1,
                                stop:0 rgba(99, 102, 241, 0.3), stop:1 rgba(15, 23, 42, 1));
}

/* ========================================
   QToolButton - Modern Toolbar Buttons
   ======================================== */
QToolButton {
    background: rgba(30, 41, 59, 0.8);
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 6px;
    color: #F8FAFC;
    padding: 6px;
}

QToolButton:hover {
    background: rgba(99, 102, 241, 0.2);
    border: 1px solid rgba(99, 102, 241, 0.4);
}

QToolButton:pressed {
    background: rgba(99, 102, 241, 0.4);
}

/* ========================================
   QDockWidget - Styled Dock Panels
   ======================================== */
QDockWidget {
    background: #0A0E1A;
    border: 1px solid rgba(99, 102, 241, 0.2);
    titlebar-close-icon: none;
    titlebar-normal-icon: none;
}

QDockWidget::title {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(99, 102, 241, 0.15), stop:1 rgba(139, 92, 246, 0.08));
    border-bottom: 2px solid rgba(99, 102, 241, 0.4);
    padding: 8px 12px;
    font-weight: 700;
    font-size: 12px;
    color: #A5B4FC;
    text-align: left;
}

QDockWidget::close-button, QDockWidget::float-button {
    background: transparent;
    border: none;
    padding: 2px;
}

QDockWidget::close-button:hover, QDockWidget::float-button:hover {
    background: rgba(99, 102, 241, 0.3);
    border-radius: 4px;
}

/* ========================================
   QSplitter - Thin Styled Handles
   ======================================== */
QSplitter::handle {
    background: rgba(99, 102, 241, 0.2);
}

QSplitter::handle:horizontal {
    width: 2px;
}

QSplitter::handle:vertical {
    height: 2px;
}

QSplitter::handle:hover {
    background: rgba(99, 102, 241, 0.5);
}

/* ========================================
   QDialog - Glass Morphism Modal
   ======================================== */
QDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #0F1629, stop:1 #0A0E1A);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 12px;
}

/* ========================================
   QProgressDialog - Dark Themed
   ======================================== */
QProgressDialog {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:1,
                                stop:0 #0F1629, stop:1 #0A0E1A);
    border: 1px solid rgba(99, 102, 241, 0.3);
    border-radius: 12px;
}

QProgressDialog QLabel {
    color: #E2E8F0;
    font-size: 13px;
}

QProgressDialog QProgressBar {
    min-height: 20px;
}

/* ========================================
   StatisticsWidget - Stat Card Styling
   ======================================== */
#StatisticsWidget {
    background: qlineargradient(x1:0, y1:0, x2:1, y2:0,
                                stop:0 rgba(21, 27, 46, 0.95), stop:1 rgba(15, 23, 42, 0.9));
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 12px;
    padding: 4px 8px;
}

/* ========================================
   QTextEdit - Themed Text Areas
   ======================================== */
QTextEdit {
    background: rgba(10, 14, 26, 0.95);
    border: 1px solid rgba(99, 102, 241, 0.2);
    border-radius: 8px;
    color: #E2E8F0;
    padding: 8px;
    selection-background-color: rgba(99, 102, 241, 0.3);
    selection-color: #FFFFFF;
}

QTextEdit:focus {
    border: 1px solid rgba(99, 102, 241, 0.5);
}

/* ========================================
   QSpinBox - Dark Themed Spin Boxes
   ======================================== */
QSpinBox, QDoubleSpinBox {
    background: rgba(15, 23, 42, 0.8);
    border: 2px solid rgba(99, 102, 241, 0.3);
    border-radius: 8px;
    color: #F8FAFC;
    padding: 6px 10px;
}

QSpinBox:focus, QDoubleSpinBox:focus {
    border: 2px solid rgba(99, 102, 241, 0.8);
}
