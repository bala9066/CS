# Optional initial defaults for the LLM gateway.
# These seed settings.json on first run. The user can override them in the
# Settings dialog in the web UI. The access token is stored server-side only.

PORT=3001

# Examples (pick the one matching your gateway):
#   Gemini:    https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash:generateContent
#   Anthropic: https://api.anthropic.com
#   OpenAI:    https://api.openai.com/v1
GATEWAY_URL=
ACCESS_TOKEN=
TARGET_MODEL=gemini-2.0-flash
TEMPERATURE=0
MAX_TOKENS=4096
